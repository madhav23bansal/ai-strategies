// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tokens from Kamino data
model Token {
  id          String @id @default(cuid())
  mint        String @unique
  name        String
  symbol      String
  decimals    Int
  logoUrl     String
  marketCapUsd Decimal @db.Decimal(20, 6)
  volumeUsd   Decimal @db.Decimal(20, 6)
  verified    Boolean @default(false)
  priority    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  collateralPairs KaminoPair[] @relation("CollateralToken")
  debtPairs        KaminoPair[] @relation("DebtToken")

  @@map("tokens")
}

// Kamino Lending Markets
model KaminoLendingMarket {
  id          String @id @default(cuid())
  address     String @unique
  name        String
  description String
  lookupTable String
  isCurated   Boolean @default(false)
  isPrimary   Boolean @default(false)
  configKey   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  pairs KaminoPair[]

  @@map("kamino_lending_markets")
}

// Kamino Pairs (trading pairs within lending markets)
model KaminoPair {
  id                    String @id @default(cuid())
  depositReserveAddress String
  borrowReserveAddress  String
  pairType              String
  strategyType          String
  supplyApyType         String
  supplyApyAddress      String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  lendingMarketId   String
  lendingMarket     KaminoLendingMarket @relation(fields: [lendingMarketId], references: [id], onDelete: Cascade)
  collateralTokenId String
  collateralToken   Token @relation("CollateralToken", fields: [collateralTokenId], references: [id])
  debtTokenId       String
  debtToken         Token @relation("DebtToken", fields: [debtTokenId], references: [id])

  // Related data
  filterTypes      KaminoFilterType[]
  historicalApy    KaminoHistoricalApy[]

  @@unique([depositReserveAddress, borrowReserveAddress])
  @@map("kamino_pairs")
}

// Filter types for pairs (e.g., "volatile", "perp")
model KaminoFilterType {
  id        String @id @default(cuid())
  filterType String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  pairId String
  pair   KaminoPair @relation(fields: [pairId], references: [id], onDelete: Cascade)

  @@unique([pairId, filterType])
  @@map("kamino_filter_types")
}

// Historical APY data for pairs
model KaminoHistoricalApy {
  id         String @id @default(cuid())
  date       DateTime
  stakingApy Decimal @db.Decimal(10, 6)
  debtApy    Decimal @db.Decimal(10, 6)
  timeRange  String // "7D", "1M", "3M"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  pairId String
  pair   KaminoPair @relation(fields: [pairId], references: [id], onDelete: Cascade)

  @@unique([pairId, date, timeRange])
  @@map("kamino_historical_apy")
}

// Metadata for the data import
model KaminoDataImport {
  id                        String @id @default(cuid())
  generatedAt               DateTime
  totalMarkets              Int
  totalTokenMints           Int
  totalTokens               Int
  historicalApyFetchedAt   DateTime
  totalPairsProcessed       Int
  totalPairs                Int
  sources                   Json // Store the sources object as JSON
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@map("kamino_data_imports")
}