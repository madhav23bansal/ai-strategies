			{
				"name": "slippage",
				"displayName": "Slippage",
				"type": "number",
				"required": false,
				"description": "Slippage tolerance in basis points",
				"default": 50,
				"validation": {
					"min": 1,
					"max": 1000
				}
			}
		]
