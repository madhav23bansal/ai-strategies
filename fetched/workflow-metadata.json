[
	{
		"metadata": {
			"version": 1,
			"category": "transaction-management",
			"id": "transaction.submit",
			"displayName": "Submit Transactions",
			"description": "Submits transactions to blockchain or simulates them without execution. Pauses workflow to wait for signatures when submitting.",
			"icon": "/workflow/nodes/cursor-select.svg",
			"tags": [
				"blockchain",
				"transaction",
				"submit",
				"simulate",
				"solana"
			]
		},
		"parameters": [
			{
				"name": "transactions",
				"displayName": "Transactions",
				"type": "transaction-array",
				"required": true,
				"description": "Array of unsigned transactions to submit",
				"placeholder": "{{ $node1.transactions }}"
			},
			{
				"name": "submitMethod",
				"displayName": "Submit Method",
				"type": "string",
				"required": false,
				"description": "How to submit transactions",
				"default": "rpc",
				"options": [
					{
						"label": "Direct RPC",
						"value": "rpc"
					},
					{
						"label": "Jito Bundle",
						"value": "jito"
					}
				]
			},
			{
				"name": "confirmationTimeout",
				"displayName": "Confirmation Timeout",
				"type": "number",
				"required": false,
				"description": "How long to wait for transaction confirmation",
				"default": 60000,
				"validation": {
					"min": 1000,
					"max": 300000
				}
			},
			{
				"name": "simulateBeforeSubmit",
				"displayName": "Simulate Before Submit",
				"type": "boolean",
				"required": false,
				"description": "Run simulation before requesting signatures (recommended)",
				"default": true
			},
			{
				"name": "stopOnSimulationFailure",
				"displayName": "Stop On Simulation Failure",
				"type": "boolean",
				"required": false,
				"description": "Fail workflow if simulation fails",
				"default": true
			},
			{
				"name": "includeSimulationData",
				"displayName": "Include Simulation Data",
				"type": "boolean",
				"required": true,
				"description": "Include detailed simulation results in output",
				"default": false
			},
			{
				"name": "simulateOnly",
				"displayName": "Simulate Only",
				"type": "boolean",
				"required": true,
				"description": "Only simulate transactions without submitting them",
				"default": false
			},
			{
				"name": "useJito",
				"displayName": "Use Jito",
				"type": "boolean",
				"required": false,
				"description": "Simulate all transactions as a bundle in one RPC call (faster, Jito-compatible)",
				"default": true
			},
			{
				"name": "includeAccounts",
				"displayName": "Include Accounts",
				"type": "boolean",
				"required": true,
				"description": "Include account data in simulation results",
				"default": false
			},
			{
				"name": "failOnSimulationError",
				"displayName": "Fail On Simulation Error",
				"type": "boolean",
				"required": false,
				"description": "Fail the workflow if any simulation fails",
				"default": true
			}
		]
	},
	{
		"metadata": {
